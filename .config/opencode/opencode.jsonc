{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" }
  ],
  "lsp": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "chrome-devtools-mcp@latest"
        ]
      }
    }
  },
  "agents": {
    "plan": {
      "model": "opencode-go/qwen3.7-plus"
      // "model": "opencode-go/deepseek-v4-pro"
    },
    "build": {
      "model": "opencode-go/deepseek-v4-pro"
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@1.1.0"
  ]
}
